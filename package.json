{
  "name": "morph",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "bin": {
    "morph": "./dist/cli/index.js"
  },
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "Mikul Gohil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikulgohil/Morph.git"
  },
  "homepage": "https://github.com/mikulgohil/Morph",
  "bugs": {
    "url": "https://github.com/mikulgohil/Morph/issues"
  },
  "keywords": [
    "website-cloner",
    "website-to-code",
    "reverse-engineering",
    "nextjs",
    "ai",
    "tailwindcss",
    "shadcn-ui",
    "design-tokens",
    "cli",
    "playwright",
    "visual-regression"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "build:cli": "node --loader ts-node/esm scripts/build-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "ora": "^9.3.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.0",
    "pngjs": "^7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/glob": "^8.1.0",
    "@types/node": "^24",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
